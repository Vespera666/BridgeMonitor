/* ============================================================
   万州三桥桥梁监测系统 — 全局样式表
   Qt 6.11 / C++17
   ============================================================ */

/* ── 全局默认 ── */
* {
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #2C3E50;
}
QMainWindow, QDialog {
    background-color: #F5F6FA;
}

/* ── QPushButton ── */
QPushButton {
    background: #2C3E50;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 7px 18px;
    min-width: 80px;
    font-weight: bold;
}
QPushButton:hover {
    background: #34495E;
}
QPushButton:pressed {
    background: #1A252F;
}
QPushButton:disabled {
    background: #BDC3C7;
    color: #7F8C8D;
}

/* 导航按钮（主窗口左侧面板） */
QPushButton[cssClass="nav-btn"] {
    background: #2C3E50;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 12px 14px;
    text-align: left;
    font-size: 14px;
}
QPushButton[cssClass="nav-btn"]:hover {
    background: #34495E;
}

/* 次要按钮（取消/关闭类） */
QPushButton[cssClass="btn-secondary"] {
    background: #ECF0F1;
    color: #2C3E50;
    border: 1px solid #DCDFE6;
}
QPushButton[cssClass="btn-secondary"]:hover {
    background: #DCDFE6;
}

/* 危险按钮（删除类） */
QPushButton[cssClass="btn-danger"] {
    background: #E74C3C;
    color: white;
}
QPushButton[cssClass="btn-danger"]:hover {
    background: #C0392B;
}

/* ── QLineEdit / QDateEdit / QSpinBox / QComboBox ── */
QLineEdit, QDateEdit, QSpinBox, QComboBox {
    background: white;
    border: 1px solid #DCDFE6;
    border-radius: 3px;
    padding: 5px 8px;
    color: #2C3E50;
}
QLineEdit:focus, QDateEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #3498DB;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background: white;
    border: 1px solid #DCDFE6;
    selection-background-color: #3498DB;
    selection-color: white;
}

/* ── QTableView / QTableWidget ── */
QHeaderView::section {
    background: #2C3E50;
    color: white;
    padding: 6px 8px;
    border: none;
    font-weight: bold;
}
QTableView, QTableWidget {
    background: white;
    border: 1px solid #DCDFE6;
    gridline-color: #ECF0F1;
    selection-background-color: #3498DB;
    selection-color: white;
    alternate-background-color: #F9FAFB;
}

/* ── QGroupBox ── */
QGroupBox {
    font-weight: bold;
    border: 1px solid #DCDFE6;
    border-radius: 5px;
    margin-top: 12px;
    padding-top: 16px;
    background: white;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #2C3E50;
}

/* ── QTabWidget / QTabBar ── */
QTabWidget::pane {
    border: 1px solid #DCDFE6;
    background: white;
}
QTabBar::tab {
    background: #ECF0F1;
    color: #7F8C8D;
    padding: 8px 20px;
    border: 1px solid #DCDFE6;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background: white;
    color: #2C3E50;
    font-weight: bold;
}
QTabBar::tab:hover:!selected {
    color: #3498DB;
}

/* ── QSplitter::handle ── */
QSplitter::handle {
    background: #DCDFE6;
    width: 2px;
    height: 2px;
}
QSplitter::handle:hover {
    background: #3498DB;
}

/* ── 状态标签类 ── */
QLabel[cssClass="info"] {
    color: #7F8C8D;
    font-weight: bold;
    padding: 4px;
}
QLabel[cssClass="success"] {
    color: #27AE60;
    font-weight: bold;
    padding: 4px;
}
QLabel[cssClass="warning"] {
    color: #E67E22;
    font-weight: bold;
    padding: 4px;
}
QLabel[cssClass="error"] {
    color: #E74C3C;
    font-weight: bold;
    padding: 4px;
}

/* ── QScrollBar ── */
QScrollBar:vertical {
    width: 8px;
    background: #F5F6FA;
}
QScrollBar::handle:vertical {
    background: #BDC3C7;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #95A5A6;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    height: 8px;
    background: #F5F6FA;
}
QScrollBar::handle:horizontal {
    background: #BDC3C7;
    border-radius: 4px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #95A5A6;
}

/* ── QToolTip ── */
QToolTip {
    background-color: #FFFFFF;
    color: #2C3E50;
    border: 1px solid #DCDFE6;
    border-radius: 3px;
    padding: 4px 8px;
}

/* ── QStatusBar ── */
QStatusBar {
    background-color: #ECF0F1;
    color: #7F8C8D;
    border-top: 1px solid #DCDFE6;
}
